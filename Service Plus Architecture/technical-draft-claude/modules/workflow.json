  "cards": [
    { "dot": "cyan", "title": "How it works", "items": ["The service owner draws the steps in a browser editor and saves each change as a new version", "Publishing a version makes it live; running cases keep the version they started with", "The Application Service starts a case; the engine asks the Office Directory who handles it", "Officers act through the API Manager, and the engine moves the case to its next step"] },
    { "dot": "emerald", "title": "What we use", "items": ["Flowable, an open-source BPMN engine, so we do not build our own", "bpmn.io for drawing, PostgreSQL for versions and cases", "Kafka for events, WSO2 Micro Integrator for outside checks", "WSO2 Identity Server tokens tell the engine who is acting"] },
    { "dot": "rose", "title": "Rules we keep", "items": ["A button's label never decides what happens; each action has a fixed ID", "An officer can act only on cases for their office and role", "Reviews can split and join; deadlines start timers and escalate", "A correction sends the same case back to the citizen and then to the same officer"] },
    { "dot": "amber", "title": "When something fails", "items": ["A failed outside check is retried, then goes to a problem list for the office admin", "A failed message never undoes a decision", "Every step is recorded and cannot be edited later"] }
